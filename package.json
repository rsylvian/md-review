{
  "name": "@rsylvian/md-review",
  "version": "0.2.0",
  "description": "Review AI-generated markdown in your browser; hand the comments back to the agent.",
  "license": "MIT",
  "author": "Romain Sylvian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsylvian/md-review.git"
  },
  "bugs": {
    "url": "https://github.com/rsylvian/md-review/issues"
  },
  "keywords": [
    "markdown",
    "review",
    "cli",
    "claude-code",
    "agent"
  ],
  "type": "module",
  "bin": {
    "md-review": "./dist/cli.js"
  },
  "files": [
    "dist",
    "client",
    "skill"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "//prepare": "Builds dist/ so `npm i -g <git-url>` yields a working binary. Inlined rather than `npm run build` because a nested npm run does not inherit node_modules/.bin on PATH during a git install.",
    "prepare": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "hast-util-to-html": "9.0.5",
    "htm": "3.1.1",
    "micromark-util-decode-string": "2.0.1",
    "preact": "10.29.8",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.11.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
